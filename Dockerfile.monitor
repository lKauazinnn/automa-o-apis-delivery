# Imagem só do worker contínuo (worker/monitor.py) — pra rodar em VPS, Railway, Fly.io etc.
# As variáveis de ambiente são as mesmas do backend (.env): IFOOD_*, SUPABASE_*, FOOD99_*.
#   docker build -f Dockerfile.monitor -t pausafast-monitor .
#   docker run -d --restart=always --env-file .env pausafast-monitor
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY src ./src
COPY server ./server
COPY worker ./worker
ENV PYTHONUNBUFFERED=1
CMD ["python", "worker/monitor.py"]
