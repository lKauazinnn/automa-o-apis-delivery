# ============================================================
#  .env.example  —  MODELO (pode ir pro git, NÃO contém segredo)
#  Copie para .env e preencha os valores reais:  cp .env.example .env
# ============================================================

# iFood (app iFood Developer) — OBRIGATÓRIO
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_MERCHANT_ID=          # rode: python scripts/descobrir_lojas.py
# Opcional: app iFood só financeiro (escopo "conciliator"). Usado pela tela Financeiro.
IFOOD_FIN_CLIENT_ID=
IFOOD_FIN_CLIENT_SECRET=

# Supabase (login/papéis/auditoria) — OBRIGATÓRIO
SUPABASE_URL=               # https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=  # Settings > API (server-side, NUNCA no front)
SUPABASE_ANON_KEY=          # Settings > API (pode ir pro navegador)

# Opcionais
VIEWER_ORIGIN=http://localhost:5173
FLASK_DEBUG=0
IFOOD_WEBHOOK_VALIDAR_ASSINATURA=1   # 0 só pra testar o webhook com curl localmente

# 99Food (só se usar as rotas do 99Food)
FOOD99_APP_ID=
FOOD99_APP_SECRET=

# Marca padrão (white-label) — usada até um administrador salvar a marca no painel (Administração > Marca)
MARCA_NOME=PausaFast
MARCA_COR=#2B59C3

# Aviso no WhatsApp quando uma loja fecha/reabre (server/alertas.py). Vazio = só log.
ALERTA_WHATSAPP_NUMEROS=            # com DDI, separados por vírgula: 5561999999999,5511888888888
ALERTA_WHATSAPP_PROVEDOR=           # callmebot | zapi | evolution | webhook
ALERTA_IGNORAR_FORA_DO_HORARIO=1    # 1 = não avisa quando fecha só por horário de funcionamento
CALLMEBOT_APIKEY=                   # callmebot (grátis): mande "I allow callmebot to send me messages" p/ +34 644 66 32 62
ZAPI_INSTANCIA=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
EVOLUTION_URL=
EVOLUTION_INSTANCIA=
EVOLUTION_APIKEY=
ALERTA_WEBHOOK_URL=                 # Make / n8n / Zapier: recebe POST {numero, mensagem, loja, merchant_id, aberta, motivo}
