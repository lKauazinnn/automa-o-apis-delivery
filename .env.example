# ============================================================
#  .env.example  —  MODELO (pode ir pro git, NÃO contém segredo)
#  Copie para .env e preencha os valores reais:  cp .env.example .env
# ============================================================

# iFood (app iFood Developer) — OBRIGATÓRIO
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_MERCHANT_ID=          # rode: python scripts/descobrir_lojas.py

# Supabase (login/papéis/auditoria) — OBRIGATÓRIO
SUPABASE_URL=               # https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=  # Settings > API (server-side, NUNCA no front)
SUPABASE_ANON_KEY=          # Settings > API (pode ir pro navegador)

# Opcionais
VIEWER_ORIGIN=http://localhost:5173
FLASK_DEBUG=0
IFOOD_WEBHOOK_VALIDAR_ASSINATURA=1   # 0 só pra testar o webhook com curl localmente

# 99Food (só se usar as rotas do 99Food)
FOOD99_APP_ID=
FOOD99_APP_SECRET=

# Marca padrão (white-label) — usada até um administrador salvar a marca no painel (Administração > Marca)
MARCA_NOME=PausaFast
MARCA_COR=#2B59C3
